# Copy this file to `.env` and fill in what you need. `.env` is gitignored (never committed).
# You can also set most of these straight from the web dashboard — it writes them here for you.
# No Anthropic/Claude key is needed anywhere.

# ============ TEXT BRAIN (bio + prompts + analysis) ============
# Pick ONE: hf (Hugging Face API) | gemini (Google) | ollama (local, free)
LLM_BACKEND=hf
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# --- Hugging Face Inference API  (LLM_BACKEND=hf) ---
# Free token: https://huggingface.co/settings/tokens   (a "Read" token is enough)
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Google Gemini  (LLM_BACKEND=gemini, and/or photo vision) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local model via Ollama  (LLM_BACKEND=ollama) — install from https://ollama.com ---
# then e.g.  ollama pull llama3.1
OLLAMA_MODEL=llama3.1

# ============ PHOTO VISION (optional, analyzes your pictures) ============
# Which engine looks at photos: gemini (uses GEMINI_API_KEY) | ollama (local, free)
VISION_BACKEND=ollama
# Local vision model when VISION_BACKEND=ollama:  moondream (~830MB) or llava (~4.7GB)
VISION_MODEL=moondream

# ============ TINDER ============
# Normally you paste this in the dashboard each session (it expires). Only set it here if you
# want to run the CLI scripts (run_pipeline.py / src/*_demo.py) without the web UI.
TINDER_X_AUTH_TOKEN=
