# Copy to .env and fill in. .env is gitignored. NO Anthropic/Claude keys needed.

# Pick ONE backend:  hf  (Hugging Face API)  OR  ollama  (local)
LLM_BACKEND=hf

# Shared knobs
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# --- Option A: Hugging Face Inference API ---
# Get a token at https://huggingface.co/settings/tokens (read scope is enough)
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Option B: local via Ollama (https://ollama.com) ---
# After installing Ollama:  ollama pull llama3.1   (or qwen2.5, mistral, etc.)
OLLAMA_MODEL=llama3.1

# --- Multimodal local Vision Model (for photo analysis) ---
# Pick "moondream" (tiny, 829MB, extremely fast on 8GB RAM laptops) or "llava" (large, 4.7GB)
VISION_MODEL=moondream

# --- Google Gemini Vision API Key (Optional fallback/alternative) ---
GEMINI_API_KEY=

# --- Connector (only when you wire up live Tinder later; see README) ---
TINDER_X_AUTH_TOKEN=
