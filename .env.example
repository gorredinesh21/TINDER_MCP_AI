# Wingman AI configuration — copy to .env for local runs.
# The AI is Google Cloud Gemini via Vertex AI: on this machine it authenticates
# with your gcloud login (no API key needed). GEMINI_API_KEY is an optional
# fallback for machines without gcloud.

ENV=local

# --- AI (Google Cloud Gemini) ---
GCP_PROJECT=personal-project-dg21
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=            # optional AI Studio fallback
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=3072

# --- Sessions ---
SESSION_TTL_SECONDS=7200

# --- Never put a Tinder token in this file. ---
# Paste it in the app (http://127.0.0.1:8000) — it stays in memory for your
# session only and is dropped on Disconnect or expiry.
